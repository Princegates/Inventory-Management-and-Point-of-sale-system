NODE_ENV=development
PORT=4000

# Local/dev Postgres (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ims_pos
DB_USER=ims_pos
DB_PASSWORD=ims_pos

# Hosted Postgres (e.g. Supabase). When set, this takes priority over the DB_* vars above and
# SSL is enabled automatically. Get this from Supabase: Project Settings -> Database ->
# Connection string (URI) -> use the "Transaction pooler" string for serverless/PaaS hosts.
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Comma separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Default admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# The client's URL - used to build links inside emails (e.g. the password reset link).
FRONTEND_URL=http://localhost:5173

# Password reset emails, sent via Resend (https://resend.com - free tier available).
# Get an API key from Resend's dashboard. Without it, password reset falls back to returning
# the reset token directly in the API response instead of emailing it (dev-friendly, no
# account needed) - fine for local development, not for a real deployment.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=IMS + POS <onboarding@resend.dev>
# ^ Resend's shared onboarding@resend.dev sender works immediately with no setup, but only
# delivers to the email address you signed up to Resend with. To email your real users, verify
# your own domain in Resend and set EMAIL_FROM to an address on it, e.g. "Zyente Tech <noreply@yourdomain.com>".
